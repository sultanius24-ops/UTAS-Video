{
  "name": "utas-quality-day-promo",
  "version": "1.0.0",
  "private": true,
  "description": "UTAS Quality Day new logo countdown, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "node scripts/render-all.mjs",
    "still": "remotion still LogoLoop renders/logo-screen.png --frame=0",
    "typecheck": "tsc --noEmit",
    "generate:audio": "python scripts/generate_audio.py",
    "split:logo": "python scripts/split_logo.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "@remotion/zod-types": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.0.0",
    "@fontsource/montserrat": "^5.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
